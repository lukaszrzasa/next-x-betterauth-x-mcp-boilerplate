          "value": "(\"email_log\".\"requester_kind\" = 'user' AND \"email_log\".\"requester_id\" IS NOT NULL AND \"email_log\".\"requester_id\" <> '')\n        OR (\"email_log\".\"requester_kind\" = 'anonymous' AND \"email_log\".\"requester_id\" IS NULL AND \"email_log\".\"requester_label\" = 'Anonymous')"
        },
        "email_log_chain_check": {
          "name": "email_log_chain_check",
          "value": "(\"email_log\".\"original_log_id\" IS NULL AND \"email_log\".\"previous_attempt_id\" IS NULL AND \"email_log\".\"attempt_number\" = 1)\n        OR (\"email_log\".\"original_log_id\" IS NOT NULL AND \"email_log\".\"previous_attempt_id\" IS NOT NULL\n          AND \"email_log\".\"original_log_id\" <> \"email_log\".\"id\" AND \"email_log\".\"previous_attempt_id\" <> \"email_log\".\"id\"\n          AND \"email_log\".\"attempt_number\" > 1)"
        },
        "email_log_completion_check": {
          "name": "email_log_completion_check",
          "value": "(\"email_log\".\"status\" = 'sending' AND \"email_log\".\"completed_at\" IS NULL AND \"email_log\".\"completion_digest\" IS NULL)\n        OR (\"email_log\".\"status\" <> 'sending' AND \"email_log\".\"completed_at\" IS NOT NULL\n          AND \"email_log\".\"completed_at\" >= \"email_log\".\"started_at\" AND \"email_log\".\"completion_digest\" IS NOT NULL)"
        },
        "email_log_recipient_email_check": {
          "name": "email_log_recipient_email_check",
          "value": "\"email_log\".\"recipient_email\" <> '' AND \"email_log\".\"recipient_email\" = lower(\"email_log\".\"recipient_email\")"
        },
        "email_log_text_check": {
          "name": "email_log_text_check",
          "value": "\"email_log\".\"record_key\" <> '' AND \"email_log\".\"requester_label\" <> '' AND \"email_log\".\"request_id\" <> ''\n        AND \"email_log\".\"subject\" <> '' AND \"email_log\".\"content_text\" <> ''\n        AND octet_length(\"email_log\".\"content_text\") <= 131072\n        AND (\"email_log\".\"error_message\" IS NULL OR char_length(\"email_log\".\"error_message\") <= 4000)\n        AND (\"email_log\".\"stack_trace\" IS NULL OR octet_length(\"email_log\".\"stack_trace\") <= 32768)"
        },
        "email_log_digest_check": {
          "name": "email_log_digest_check",
          "value": "\"email_log\".\"input_digest\" ~ '^[0-9a-f]{64}$'\n        AND (\"email_log\".\"completion_digest\" IS NULL OR \"email_log\".\"completion_digest\" ~ '^[0-9a-f]{64}$')"
        },
        "email_log_redaction_version_check": {
          "name": "email_log_redaction_version_check",
          "value": "\"email_log\".\"redaction_version\" >= 1"
        }
      },
      "isRLSEnabled": false
    },
